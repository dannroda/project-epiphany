; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Epiphany"
config/version="0.2"
run/main_scene="res://src/ui/title/title_screen.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
boot_splash/bg_color=Color(0.043137256, 0.050980393, 0.0627451, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/ui/logo/epiphany_splash.png"
config/icon="res://assets/branding/icon.png"

[autoload]

Items="*uid://c3fthcnre0g0f"
GameState="*res://src/state/game_state.gd"
Players="*res://src/state/players.gd"
SaveManager="*res://src/save/save_manager.gd"
Log="*res://addons/epiphany_tools/debug/runtime/log.gd"
DebugOverlay="*res://addons/epiphany_tools/debug/runtime/debug_overlay.gd"
SceneFlow="*res://src/flow/scene_flow.tscn"
MenuStack="*res://src/ui/menus/menu_stack.gd"
Feel="*res://src/feel/feel.gd"
InputDevice="*res://src/input/input_device.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Settings="*res://src/settings/settings.gd"
Music="*res://src/audio/music.tscn"

[dialogue_manager]

editor/translations/use_static_ids_as_translation_keys=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/editor_bridge/plugin.cfg", "res://addons/epiphany_tools/plugin.cfg", "res://addons/scope_compass/plugin.cfg", "res://addons/zylann.editor_debugger/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange"
}

[gui]

theme/custom="res://src/ui/theme.tres"

[importer_defaults]

scene={
"blender/nodes/visible": 2.0
}

