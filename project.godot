[internationalization]

locale/translations=PackedStringArray("res://translations/es.po", "res://translations/en.po")
locale/translations_pot_files=PackedStringArray("res://data/dialogue/test_tablets.dialogue", "res://data/dialogue/item_get.dialogue", "res://data/dialogue/doors.dialogue", "res://data/dialogue/overworld.dialogue", "res://data/dialogue/temple.dialogue", "res://data/dialogue/ending.dialogue")
locale/fallback="es"

[layer_names]

3d_physics/layer_1="Level"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="Object"
3d_physics/layer_5="Hurtbox"
3d_physics/layer_6="Interactable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/contact_shadow/enabled=true
lights_and_shadows/multi_bounce_occlusion/enabled=true

[shader_globals]

player_hole={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
