[gd_scene format=3]

[ext_resource type="Script" path="res://src/audio/music.gd" id="1_music"]
[ext_resource type="AudioStream" path="res://assets/audio/music/calm.wav" id="2_calm"]
[ext_resource type="AudioStream" path="res://assets/audio/music/dark.wav" id="3_dark"]
[ext_resource type="AudioStream" path="res://assets/audio/music/pulse.wav" id="4_pulse"]
