[gd_scene format=3]

[node name="DungeonChip" type="PanelContainer"]
theme_type_variation = &"Chip"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Icon" type="TextureRect" parent="Row"]
custom_minimum_size = Vector2(22, 22)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Label" type="Label" parent="Row"]
layout_mode = 2
theme_type_variation = &"Value"
