[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/menus/items_page.gd" id="1_page"]
[ext_resource type="PackedScene" path="res://src/ui/menus/item_detail.tscn" id="2_detail"]

[node name="Ítems" type="HBoxContainer"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 40
script = ExtResource("1_page")

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 22

[node name="Grid" type="GridContainer" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
columns = 4

[node name="Dungeon" type="VBoxContainer" parent="Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(432, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="DungeonTitle" type="Label" parent="Rows/Dungeon"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caps"

[node name="Chips" type="HFlowContainer" parent="Rows/Dungeon"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Detail" parent="." instance=ExtResource("2_detail")]
unique_name_in_owner = true
layout_mode = 2
