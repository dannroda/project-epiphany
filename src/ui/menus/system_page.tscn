[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/menus/system_page.gd" id="1_page"]
[ext_resource type="PackedScene" path="res://src/ui/menus/options_panel.tscn" id="2_panel"]
[ext_resource type="PackedScene" path="res://src/ui/menus/menu_item_small.tscn" id="3_item"]

[node name="Sistema" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_page")

[node name="Column" type="VBoxContainer" parent="."]
