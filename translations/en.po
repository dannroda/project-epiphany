msgid "ITEM_SHIELD_MIRROR_GOT"
msgstr "You got the Mirror Shield!"

msgid "ITEM_SHIELD_WOOD_NAME"
msgstr "Wooden Shield"

msgid "ITEM_SHIELD_WOOD_DESC"
msgstr "Blocks blows coming from the front. With your guard up, attacking makes a shield bash that stuns."

msgid "ITEM_SHIELD_WOOD_GOT"
msgstr "You got the Wooden Shield!"

msgid "ITEM_SMALL_KEY_NAME"
msgstr "Small Key"

msgid "ITEM_SMALL_KEY_DESC"
msgstr "Opens a locked door in this dungeon."

msgid "ITEM_SMALL_KEY_GOT"
msgstr "You got a Small Key!"

msgid "ITEM_SWORD_BASIC_NAME"
msgstr "Sword"

msgid "ITEM_SWORD_BASIC_DESC"
msgstr "A simple, trusty one-handed sword. Strikes ahead and pushes back."

msgid "ITEM_SWORD_BASIC_GOT"
msgstr "You got the Sword!"

msgid "ITEM_TUNIC_NAME"
msgstr "Tunic"

msgid "ITEM_TUNIC_DESC"
msgstr "Travelling clothes. Not much protection, but comfortable."

msgid "ITEM_TUNIC_GOT"
msgstr "You got the Tunic!"

