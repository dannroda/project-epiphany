msgid "ITEM_BOMB_BAG_NAME"
msgstr "Bomb Bag"

msgid "ITEM_BOMB_BAG_DESC"
msgstr "Tap the button to set a bomb down in front of you; hold it to pick the bomb up, aim and throw it. Breaks cracked walls and pushes away whatever is nearby."

msgid "ITEM_BOMB_BAG_GOT"
msgstr "You got the Bomb Bag!"

msgid "ITEM_BOMB_NAME"
msgstr "Bombs"

msgid "ITEM_BOMB_DESC"
