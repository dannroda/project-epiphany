msgid "ITEM_BOTTLE_EMPTY_GOT"
msgstr "You got an Empty Bottle!"

msgid "ITEM_BOW_NAME"
msgstr "Bow"

msgid "ITEM_BOW_DESC"
msgstr "Shoots arrows wherever you aim: right stick, mouse or your locked-on target. Reaches distant switches."

msgid "ITEM_BOW_GOT"
msgstr "You got the Bow!"

msgid "ITEM_COMPASS_NAME"
msgstr "Compass"

msgid "ITEM_COMPASS_DESC"
msgstr "Marks the chests and the guardian's chamber on the map."

msgid "ITEM_COMPASS_GOT"
msgstr "You got the Compass!"

msgid "ITEM_DUNGEON_MAP_NAME"
msgstr "Dungeon Map"

msgid "ITEM_DUNGEON_MAP_DESC"
msgstr "Shows every room in the dungeon."

msgid "ITEM_DUNGEON_MAP_GOT"
msgstr "You got the Dungeon Map!"

msgid "ITEM_HEART_CONTAINER_NAME"
msgstr "Heart Container"

msgid "ITEM_HEART_CONTAINER_DESC"
msgstr "Adds a heart to your maximum health."

msgid "ITEM_HEART_CONTAINER_GOT"
msgstr "You got a Heart Container!"

msgid "ITEM_HEART_PIECE_NAME"
msgstr "Piece of Heart"

msgid "ITEM_HEART_PIECE_DESC"
msgstr "Collect four and your maximum health grows by one heart."

msgid "ITEM_HEART_PIECE_GOT"
msgstr "You got a Piece of Heart!"

msgid "ITEM_POTION_NAME"
msgstr "Potion"

msgid "ITEM_POTION_DESC"
msgstr "Restores all your health. Leaves the bottle empty."

msgid "ITEM_POTION_GOT"
msgstr "You got a Potion!"

msgid "ITEM_QUIVER_BIG_NAME"
