msgid "ITEMGET_GOT_COUNT"
msgstr "¡Conseguiste {count} {item}!"

msgid "ITEM_ARMOR_CHAINMAIL_NAME"
msgstr "Cota reforzada"

msgid "ITEM_ARMOR_CHAINMAIL_DESC"
msgstr "Placas doradas sobre una cota de anillos. Reduce el daño que recibís."

msgid "ITEM_ARMOR_CHAINMAIL_GOT"
msgstr "¡Conseguiste la Cota reforzada!"

msgid "ITEM_ARROW_NAME"
msgstr "Flechas"

msgid "ITEM_ARROW_DESC"
msgstr "Munición para el arco."

msgid "ITEM_ARROW_GOT"
msgstr "¡Conseguiste Flechas!"

msgid "ITEM_BOMB_BAG_NAME"
msgstr "Bolsa de bombas"

msgid "ITEM_BOMB_BAG_DESC"
msgstr "Tocá el botón para colocar una bomba delante tuyo; mantenelo para levantarla, apuntar y tirarla. Rompe muros agrietados y empuja lo que está cerca."

msgid "ITEM_BOMB_BAG_GOT"
msgstr "¡Conseguiste la Bolsa de bombas!"

msgid "ITEM_FEATHER_NAME"
msgstr "Pluma"

msgid "ITEM_FEATHER_DESC"
msgstr "Asignala a un botón para saltar: cruza huecos de una baldosa, sube a escalones y esquiva lo que golpea el piso. No pasa pircas ni muros."

msgid "ITEM_FEATHER_GOT"
msgstr "¡Conseguiste la Pluma!"

msgid "ITEM_SANDALS_NAME"
msgstr "Sandalias"

msgid "ITEM_SANDALS_DESC"
msgstr "Asignalas a un botón y mantenelo: toman impulso y corren recto hasta soltar o chocar. El choque sacude árboles y muros. Con la pluma en plena carrera, saltás tres baldosas."

msgid "ITEM_SANDALS_GOT"
msgstr "¡Conseguiste las Sandalias!"

msgid "ITEM_HAMMER_NAME"
msgstr "Martillo"

msgid "ITEM_HAMMER_DESC"
msgstr "Asignalo a un botón: un golpe de dos manos contra el piso. Rompe lo que la espada no puede, aprieta las placas de golpe y le baja la guardia a escudos y corazas."

msgid "ITEM_HAMMER_GOT"
msgstr "¡Conseguiste el Martillo!"

msgid "ITEM_HOOKSHOT_NAME"
msgstr "Gancho"

msgid "ITEM_HOOKSHOT_DESC"
msgstr "Dispara una cadena de cuatro baldosas. En un poste o un cofre se clava y te lleva hasta ahí, por encima del agua y los huecos. Trae vasijas y lo que esté suelto, aturde a los enemigos y le arranca la coraza al esqueleto acorazado."

msgid "ITEM_HOOKSHOT_GOT"
msgstr "¡Conseguiste el Gancho!"

msgid "ITEM_BOMB_NAME"
msgstr "Bombas"

msgid "ITEM_BOMB_DESC"
msgstr "Munición para la bolsa de bombas."

msgid "ITEM_BOMB_GOT"
msgstr "¡Conseguiste Bombas!"

msgid "ITEM_BOSS_KEY_NAME"
msgstr "Llave del jefe"

msgid "ITEM_BOSS_KEY_DESC"
msgstr "Abre la puerta del guardián de la mazmorra."

msgid "ITEM_BOSS_KEY_PIECE_NAME"
msgstr "Pieza de la llave del jefe"

msgid "ITEM_BOSS_KEY_PIECE_DESC"
msgstr "Un cuarto de la llave del jefe. Se gana en cada revancha del templo."

msgid "ITEM_BOSS_KEY_PIECE_GOT"
msgstr "¡Conseguiste una pieza de la llave del jefe!"

msgid "ITEM_BOSS_KEY_GOT"
msgstr "¡Conseguiste la Llave del jefe!"

msgid "ITEM_BOTTLE_EMPTY_NAME"
msgstr "Botella vacía"

msgid "ITEM_BOTTLE_EMPTY_DESC"
msgstr "Una botella vacía. Se puede volver a llenar."

msgid "ITEM_BOTTLE_EMPTY_GOT"
msgstr "¡Conseguiste una Botella vacía!"

msgid "ITEM_BOW_NAME"
msgstr "Arco"

msgid "ITEM_BOW_DESC"
msgstr "Dispara flechas hacia donde apuntás: stick derecho, mouse o el objetivo fijado. Alcanza interruptores lejanos."

msgid "ITEM_BOW_GOT"
msgstr "¡Conseguiste el Arco!"

msgid "ITEM_COMPASS_NAME"
msgstr "Brújula"

msgid "ITEM_COMPASS_DESC"
msgstr "Marca en el mapa los cofres y la sala del guardián."

msgid "ITEM_COMPASS_GOT"
msgstr "¡Conseguiste la Brújula!"

msgid "ITEM_DUNGEON_MAP_NAME"
msgstr "Mapa"

msgid "ITEM_DUNGEON_MAP_DESC"
msgstr "Muestra todas las salas de la mazmorra."

msgid "ITEM_DUNGEON_MAP_GOT"
msgstr "¡Conseguiste el Mapa!"

msgid "ITEM_HEART_CONTAINER_NAME"
msgstr "Contenedor de corazón"

msgid "ITEM_HEART_CONTAINER_DESC"
msgstr "Suma un corazón a tu vida máxima."

msgid "ITEM_HEART_CONTAINER_GOT"
msgstr "¡Conseguiste un Contenedor de corazón!"

msgid "ITEM_HEART_PIECE_NAME"
msgstr "Pieza de corazón"

msgid "ITEM_HEART_PIECE_DESC"
msgstr "Juntá cuatro y tu vida máxima sube un corazón."

msgid "ITEM_HEART_PIECE_GOT"
msgstr "¡Conseguiste una Pieza de corazón!"

msgid "ITEM_POTION_NAME"
msgstr "Poción"

msgid "ITEM_POTION_DESC"
msgstr "Recupera toda la vida. Deja la botella vacía."

msgid "ITEM_POTION_GOT"
msgstr "¡Conseguiste una Poción!"

msgid "ITEM_QUIVER_BIG_NAME"
msgstr "Carcaj grande"

msgid "ITEM_QUIVER_BIG_DESC"
msgstr "Permite llevar más flechas."

msgid "ITEM_QUIVER_BIG_GOT"
msgstr "¡Conseguiste el Carcaj grande!"

msgid "ITEM_SHIELD_MIRROR_NAME"
msgstr "Escudo espejo"

msgid "ITEM_SHIELD_MIRROR_DESC"
msgstr "Con el botón de fijar mantenido bloquea los golpes de frente. Refleja proyectiles y haces de luz hacia donde mirás o hacia el objetivo fijado."

msgid "ITEM_SHIELD_MIRROR_GOT"
msgstr "¡Conseguiste el Escudo espejo!"

msgid "ITEM_SHIELD_WOOD_NAME"
msgstr "Escudo de madera"

msgid "ITEM_SHIELD_WOOD_DESC"
msgstr "Con el botón de fijar mantenido bloquea los golpes que vienen de frente. Cubriéndote, atacar da una estocada que aturde."

msgid "ITEM_SHIELD_WOOD_GOT"
msgstr "¡Conseguiste el Escudo de madera!"

msgid "ITEM_SMALL_KEY_NAME"
msgstr "Llave chica"

msgid "ITEM_SMALL_KEY_DESC"
msgstr "Abre una puerta cerrada de esta mazmorra."

msgid "ITEM_SMALL_KEY_GOT"
msgstr "¡Conseguiste una Llave chica!"

msgid "ITEM_SWORD_BASIC_NAME"
msgstr "Espada"

msgid "ITEM_SWORD_BASIC_DESC"
