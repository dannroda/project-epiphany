msgid "ITEM_SWORD_BASIC_GOT"
msgstr "¡Conseguiste la Espada!"

msgid "ITEM_SWORD_GOLDEN_NAME"
msgstr "Espada dorada"

msgid "ITEM_SWORD_GOLDEN_DESC"
