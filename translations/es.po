msgid "TUT_SHIELD_MIRROR_TRY"
msgstr "El cristal de esta sala espera la luz: llevásela con el escudo."

msgid "TUT_SHIELD_MIRROR_TASK"
msgstr "Llevá la luz a un cristal"

