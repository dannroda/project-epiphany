msgid "TUT_SANDALS_BUTTON"
msgstr "Mantené {item:sandals}: tomás impulso y corrés hasta soltar o chocar."

msgid "TUT_SANDALS_TRY"
msgstr "Corré contra una queñoa y mirá qué cae."

msgid "TUT_SANDALS_TASK"
msgstr "Tomá carrera"

